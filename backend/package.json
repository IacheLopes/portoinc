{
  "name": "portoink-api",
  "version": "0.19.0",
  "private": true,
  "description": "API do sistema de compras e almoxarifado da Porto Inc.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/servidor.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed-desenvolvimento.ts && tsx prisma/seed-cadastros.ts",
    "test": "npm run test:unidade && npm run test:integracao",
    "test:unidade": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:integracao": "npm run test:preparar && NODE_ENV=test DATABASE_URL=$DATABASE_URL_TESTE node --import tsx --test --test-concurrency=1 \"testes/**/*.test.ts\"",
    "test:preparar": "DATABASE_URL=$DATABASE_URL_TESTE prisma migrate deploy",
    "tipos": "tsc --noEmit -p tsconfig.test.json",
    "seed:historico": "tsx prisma/seed-historico.ts",
    "criar-admin": "tsx prisma/criar-administrador.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^9.0.3",
    "@fastify/rate-limit": "^10.2.1",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.2.1",
    "@whiskeysockets/baileys": "^6.7.24",
    "docx": "^9.7.1",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "pdfkit": "^0.16.0",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.5",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
