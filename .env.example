# ============================================================
#  Porto Inc. - Variaveis de ambiente
#  Copie este arquivo para ".env" e ajuste os valores.
# ============================================================

# ---------- Banco de dados ----------
POSTGRES_USER=portoink
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=portoink

# ---------- Seguranca ----------
# Chave usada para assinar o login. TROQUE por um valor longo e aleatorio.
JWT_SECRET=troque_por_uma_chave_longa_e_aleatoria_de_no_minimo_32_caracteres
CORS_ORIGIN=http://localhost:5173

# ============================================================
#  ADAPTADORES DE INTEGRACAO
#  "mock"  = simulado, nao envia nada para fora (seguro para teste)
#  Os demais valores so funcionam apos a integracao ser ligada.
# ============================================================

# mock | baileys | cloud-api
WHATSAPP_ADAPTER=mock

# Trava de seguranca do WhatsApp.
# Com "true", so sai mensagem para numero cadastrado na lista de
# autorizados (tela Configuracoes > WhatsApp). Mudar para "false"
# libera o envio para qualquer numero -- faca isso conscientemente.
WHATSAPP_MODO_TESTE=true

# mock | sefaz
FISCAL_ADAPTER=mock

# mock | gs1
GTIN_ADAPTER=mock

# mock | cnab | open-finance
PAGAMENTO_ADAPTER=mock

# Banco usado pelos testes automatizados (nunca toca nos dados de desenvolvimento)
DATABASE_URL_TESTE=postgresql://portoink:troque_esta_senha@db:5432/portoink_test?schema=public

# ------------------------------------------------------------
#  E-mail
#
#  mock = nao manda nada para fora, so registra o que sairia.
#  Trocar para 'resend' exige dominio verificado e SPF/DKIM no DNS.
# ------------------------------------------------------------
# mock | resend
EMAIL_ADAPTER=mock

# Com 'true', so envia para quem esta na lista de autorizados.
EMAIL_MODO_TESTE=true

# Preencher so ao ligar o adaptador de verdade.
#EMAIL_API_TOKEN=
#EMAIL_REMETENTE=compras@suaempresa.com.br
