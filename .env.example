# ============================================================
#  Porto Inc. - Variaveis de ambiente
#
#  Copie este arquivo para ".env" e ajuste os valores:
#
#      cp .env.example .env
#
#  Os valores aqui sao SEGUROS: nada sai do sistema para fora.
#  Nenhuma mensagem, nenhum e-mail, nenhum pagamento. O sistema
#  sobe inteiro e funciona, e cada integracao externa fica
#  esperando alguem liga-la de proposito.
# ============================================================

# ---------- Banco de dados ----------
POSTGRES_USER=portoink
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=portoink

# ---------- Seguranca ----------
# Chave usada para assinar o login E para embaralhar os segredos
# guardados no banco (token de e-mail, chave da IA).
#
# TROQUE por um valor longo e aleatorio -- 32 caracteres e o
# minimo que o sistema aceita. Para gerar um:
#
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# TROCAR DEPOIS invalida os segredos ja guardados: quem ligou o
# e-mail pela tela tera de digitar a senha outra vez.
JWT_SECRET=troque_por_uma_chave_longa_e_aleatoria_de_no_minimo_32_caracteres
CORS_ORIGIN=http://localhost:5173

# Banco usado pelos testes automatizados (nunca toca nos dados de
# desenvolvimento). A senha tem de bater com a de cima.
DATABASE_URL_TESTE=postgresql://portoink:troque_esta_senha@db:5432/portoink_test?schema=public

# O endereco que entra nos LINKS que saem do sistema -- o portal
# do fornecedor no convite de cotacao, e o link de troca de senha.
#
# `localhost` serve para quem desenvolve e NAO abre no celular de
# ninguem: la, localhost e o proprio telefone. Para testar no
# celular, use o IP da sua maquina na rede (ex. http://192.168.1.10).
# Em producao, vira o dominio da empresa.
URL_PUBLICA=http://localhost:5173

# ============================================================
#  ADAPTADORES DE INTEGRACAO
#
#  Cada integracao externa e uma "tomada": o sistema conhece o
#  contrato, nunca o provedor. Trocar de provedor e mudar uma
#  linha aqui.
#
#    mock       = simulado. Finge que deu certo, sem nada sair.
#                 Serve para desenvolver e para os testes.
#    desligado  = nao finge. Recusa o envio e diz onde ligar.
#
#  A diferenca importa. `mock` responde "enviei" e a tela pinta
#  de verde; `desligado` responde "ainda nao fui ligado" e a tela
#  diz isso. Para quem esta montando a maquina, o primeiro
#  esconde e o segundo avisa.
# ============================================================

# ---------- WhatsApp ----------
# mock | baileys | cloud-api
#
# `baileys` conecta um numero de verdade por QR Code, em
# Administracao > Comunicacao > WhatsApp. E biblioteca NAO
# oficial: use um numero que a empresa possa perder.
WHATSAPP_ADAPTER=mock

# A TRAVA DE SEGURANCA DO WHATSAPP, e ela comeca LIGADA.
#
# Com "true", so sai mensagem para numero que estiver na lista de
# autorizados, em Administracao > Comunicacao. Deixe assim
# enquanto estiver testando com numeros proprios.
#
# Com "false", quem decide quem recebe e o CADASTRO do fornecedor,
# e mais nada -- e e assim que producao tem de ficar. Ligada em
# producao, o fornecedor nao recebe nada e o sistema registra
# "bloqueado" no historico: quem for procurar o defeito vai
# procurar no lugar errado.
#
# Mude para "false" de proposito, sabendo disso.
WHATSAPP_MODO_TESTE=true

# ---------- E-mail ----------
# desligado | mock | resend
#
# `desligado` e o padrao, e e o estado certo de uma instalacao
# nova: ninguem cadastrou a conta da empresa ainda.
#
# NAO E AQUI QUE SE LIGA O E-MAIL NO DIA A DIA. Quem liga e a
# tela: Administracao > Comunicacao > E-mail, com servidor SMTP,
# usuario e senha. O que a tela salva vale por cima do que esta
# escrito aqui -- a decisao mais recente e a que manda.
#
# Esta linha serve para dois casos: deixar `desligado` (normal),
# ou `mock` para os testes automatizados.
EMAIL_ADAPTER=desligado

# Preencher so para o adaptador `resend`, que exige dominio
# verificado e SPF/DKIM no DNS. Quem usa SMTP pela tela nao
# precisa de nada aqui.
#EMAIL_API_TOKEN=
#EMAIL_REMETENTE=compras@suaempresa.com.br

# ---------- Fiscal (NF-e / SEFAZ) ----------
# mock | sefaz
#
# `sefaz` depende do certificado digital A1 do CNPJ da empresa,
# que ainda nao foi entregue. Enquanto isso, simulado.
FISCAL_ADAPTER=mock

# ---------- Pagamento ----------
# mock | cnab | open-finance
#
# Os dois reais dependem de contrato com o banco.
PAGAMENTO_ADAPTER=mock

# ============================================================
#  ASSISTENTE DE IA NO WHATSAPP
#
#  Ele responde perguntas sobre o sistema, no WhatsApp, para o
#  pessoal da empresa. Le o sistema; nunca escreve nada nele.
#
#  Em branco, fica simulado: o sistema sobe inteiro e a tela diz
#  o que falta. Para ligar de verdade sao TRES coisas, e as tres
#  precisam estar de pe:
#
#    1. a chave da IA (aqui embaixo, ou pela tela);
#    2. o QR Code lido, em Comunicacao > WhatsApp;
#    3. ao menos um grupo liberado, em Administracao > Area IA.
#
#  Faltando qualquer uma, ele fica calado -- e a Area IA diz qual
#  esta faltando, em uma linha, no alto da tela.
# ============================================================

# mock | groq
IA_ADAPTER=mock

# A chave do provedor. VALE DINHEIRO e da acesso a conta: fica so
# no .env, que o git ignora. Nunca em codigo, em log nem em tela.
#
# Tambem pode ser cadastrada pela Area IA, e ai fica guardada
# embaralhada no banco.
IA_API_TOKEN=

# Deixe EM BRANCO. O adaptador pergunta ao provedor o que a conta
# tem e escolhe; chumbar um nome aqui so adianta o dia em que o
# assistente emudece porque o provedor aposentou o modelo.
IA_MODELO=

# Com "true", escreve no log do container como cada numero do
# WhatsApp foi reconhecido. Serve para investigar "ele nao me
# respondeu"; nao deixe ligado sem motivo.
IA_DIAGNOSTICO=false
